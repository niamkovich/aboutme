---
import type { App } from '../data/apps';
import { localePath, type Locale } from '../lib/locale';
import { appsPage } from './AppsPage/AppsPage.i18n';

interface Props {
  app: App;
  locale: Locale;
}

const { app, locale } = Astro.props;
const t = appsPage[locale];

const STORE_LABEL: Record<'ios' | 'android', string> = {
  ios: 'App Store',
  android: 'Google Play',
};
---

<article class="rounded-lg border border-border/70 bg-card p-4">
  <h3 class="text-base font-semibold text-foreground">{app.name}</h3>
  <p class="mt-1 text-sm text-muted-foreground">{app.tagline}</p>
  <p class="mt-3 text-sm text-foreground/80">{app.description}</p>

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    {
      app.storeLinks.map((link) =>
        link.url ? (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-md border border-border bg-card px-3.5 py-1.5 text-xs font-semibold text-foreground transition-colors hover:border-accent/50 hover:text-accent"
          >
            {STORE_LABEL[link.platform]}
          </a>
        ) : (
          <span class="inline-flex items-center gap-1.5 rounded-md border border-border/60 px-3.5 py-1.5 text-xs font-semibold text-muted-foreground">
            {STORE_LABEL[link.platform]} — {t.comingSoon}
          </span>
        ),
      )
    }
  </div>

  <div class="mt-3 text-sm">
    <a
      href={localePath(locale, `privacy/${app.slug}`)}
      class="text-muted-foreground underline underline-offset-2 decoration-accent/50 transition-colors hover:text-accent hover:decoration-accent"
    >
      {t.privacyLink}
    </a>
  </div>
</article>
