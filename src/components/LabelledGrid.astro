---
import type { Labelled } from '../data/cv';
import { inlineMarkdown } from '../lib/inline-markdown';

interface Props {
  items: Labelled[];
  /** true: split `details` on commas and render each piece as a pill (skills).
   *  false: render `details` as a single line (e.g. one proficiency level). */
  badges?: boolean;
}

const { items, badges = false } = Astro.props;
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  {
    items.map((item) => (
      <div class="rounded-md border border-border/60 bg-card p-3.5">
        <h3 class="mb-2 text-xs font-semibold text-muted-foreground uppercase tracking-wider">
          {item.label}
        </h3>
        {badges ? (
          <div class="flex flex-wrap gap-1.5">
            {item.details
              .split(',')
              .map((piece) => piece.trim())
              .filter(Boolean)
              .map((piece) => (
                <span
                  class="rounded border border-border bg-card px-2 py-0.5 font-mono text-xs text-muted-foreground"
                  set:html={inlineMarkdown(piece)}
                />
              ))}
          </div>
        ) : (
          <p class="text-sm text-foreground/80" set:html={inlineMarkdown(item.details)} />
        )}
      </div>
    ))
  }
</div>
