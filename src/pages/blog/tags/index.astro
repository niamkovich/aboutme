---
import Base from '../../../layouts/Base.astro';
import PageSection from '../../../components/PageSection.astro';
import { getBlogPosts } from '../../../lib/blog-data';
import { getAllTags } from '../../../lib/tags';
import { pluralBe } from '../../../lib/plural';

const posts = await getBlogPosts();
const tags = getAllTags(posts);
---

<Base
  locale="be"
  title="Тэгі — Блёг"
  description="Усе тэмы і тэгі артыкулаў блога."
  path="/blog/tags/"
  current="blog"
  translated={false}
>
  <PageSection>
    <h1 class="mb-2 text-3xl font-bold tracking-tight sm:text-4xl">Тэгі</h1>
    <p class="mb-8 text-base leading-relaxed text-muted-foreground">
      {tags.length}
      {pluralBe(tags.length, ['тэма', 'тэмы', 'тэм'])} ва ўсіх публікацыях.
    </p>

    <ul class="divide-y divide-border/40 border-t border-border/40">
      {
        tags.map((tag) => (
          <li>
            <a
              href={`/blog/tags/${tag.slug}/`}
              class="group flex items-baseline justify-between gap-4 py-3.5 transition-colors"
            >
              <span class="font-mono text-sm text-foreground transition-colors group-hover:text-accent">
                <span class="text-accent/70">#</span>
                {tag.name}
              </span>
              <span class="shrink-0 text-xs text-muted-foreground">
                {tag.count} {pluralBe(tag.count, ['публікацыя', 'публікацыі', 'публікацый'])}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </PageSection>
</Base>
