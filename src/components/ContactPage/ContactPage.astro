---
import Base from '../../layouts/Base.astro';
import PageSection from '../PageSection.astro';
import ContactDetails from '../ContactDetails/ContactDetails.astro';
import { getContact } from '../../data/cv';
import type { Locale } from '../../lib/locale';
import { contactPage } from './ContactPage.i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = contactPage[locale];
const contact = getContact(locale);
---

<Base
  locale={locale}
  title={`${contact.name} — ${t.title}`}
  description={t.description}
  path="contact"
  current="contact"
>
  <PageSection>
    <h1 class="mb-12 text-4xl font-bold tracking-tight text-balance md:text-5xl">{t.title}</h1>

    <ContactDetails contact={contact} locale={locale} />
  </PageSection>
</Base>
